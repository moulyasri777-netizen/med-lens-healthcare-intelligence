# MedLens AI Medical Report Intelligence Platform Environment Configuration
# Copy this file to .env for local deployment

# Environment Mode (development / production)
VITE_APP_ENV=production
VITE_APP_NAME="MedLens AI"

# Optional AI API Key (For live LLM processing fallback)
# Never expose secrets in client-side production builds
VITE_MEDLENS_AI_API_KEY=""

# Optional Maps API Key for Healthcare Location Discovery
VITE_MAPS_API_KEY=""
